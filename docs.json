{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "tracehill",
  "colors": {
    "primary": "#2F6F4E",
    "light": "#6CC497",
    "dark": "#2F6F4E"
  },
  "background": {
    "color": {
      "light": "#e9eef0",
      "dark": "#10171a"
    }
  },
  "fonts": {
    "heading": {
      "family": "Schibsted Grotesk",
      "weight": 500
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/tasks",
              "concepts/output-types",
              "concepts/feedback"
            ]
          },
          {
            "group": "Python SDK",
            "pages": [
              "sdk/python"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "POST /predict",
              "POST /predictions/{id}/feedback",
              "GET /predictions/{id}",
              "GET /predictions"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  }
}
